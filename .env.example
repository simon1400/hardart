# Copy to .env.local (never committed).
# ImageKit URL endpoint for project media. Empty: serve public/projects/ from the build.
NEXT_PUBLIC_IMAGEKIT_URL_ENDPOINT=https://ik.imagekit.io/nyr5zupwx
# ImageKit private key, only for `pnpm media:upload` on your machine. The site never needs it.
IMAGEKIT_PRIVATE_KEY=
# Umami website id, production only.
NEXT_PUBLIC_UMAMI_ID=
